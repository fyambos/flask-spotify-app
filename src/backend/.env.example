# Spotify app: https://developer.spotify.com/dashboard
# Redirect URI to register in the Spotify app settings: http://127.0.0.1:8888/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Last.fm API key (fallback genres when Spotify has none): https://www.last.fm/api/account/create
LASTFM_API_KEY=

# Optional: where config.json, cache and reports are stored (default: src/backend/data)
# SPOTSORT_DATA_DIR=
